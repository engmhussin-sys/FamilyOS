# Flutter does not read `.env` files natively — this project's Flutter
# apps read build-time config via `--dart-define` (see
# lib/core/config/app_config.dart's `String.fromEnvironment`). This file
# documents the equivalent values for consistency with the other
# projects' real `.env.example` files — copy these into your own build
# command, they are not loaded automatically.

# Example:
#   flutter run --dart-define=API_BASE_URL=http://localhost:3000/api/v1

API_BASE_URL="http://localhost:3000/api/v1"

# ===========================================================================
# PHASE G — RELEASE BUILD VARIABLES
#
# None of these is read by Dart code at runtime. They are (a) --dart-define
# values, which are compiled IN, and (b) CI / Gradle inputs. Listed here
# because this is the file a reader opens to ask "what configuration does this
# app take", and every one of them was previously undocumented.
# ===========================================================================

# --dart-define, REQUIRED on every build (audit MA-004). In RELEASE mode it
# must be https:// — AppConfig.assertUsableForBuildMode() throws StateError at
# startup otherwise, so a release artifact without it crashes on launch.
#   release:  --dart-define=API_BASE_URL=https://<host>/api/v1
#   debug:    --dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1
# (declared above as API_BASE_URL)

# --dart-define, optional, defaults to true. CI sets it to false for a parent
# debug build with no google-services.json so the app does not attempt an FCM
# registration that cannot succeed. It does NOT disable anything else.
ENABLE_PUSH="true"

# --- Gradle / keystore (NOT dart-defines) ----------------------------------
# Read by android/app/build.gradle from android/signing.properties, which is
# GITIGNORED. Copy android/signing.properties.example and fill it in; the
# keytool command to generate the keystore is inside that file. A release build
# with no signing.properties FAILS — it does not fall back to the debug key.
#   storeFile / storePassword / keyAlias / keyPassword
#
# versionCode override for CI, via Gradle's ORG_GRADLE_PROJECT_<name>
# mechanism. Must be MONOTONIC per Play upload; Play refuses a versionCode it
# has already accepted. Unset locally — pubspec.yaml's `version: <name>+<code>`
# is the single source of truth and `flutter build` propagates it.
#   ORG_GRADLE_PROJECT_abnyVersionCode=<integer>

# --- GitHub Actions secrets / variables for the release path ---------------
# Secrets (per app — the two apps are two Play listings):
#   ANDROID_KEYSTORE_BASE64_PARENT      base64 -w0 <keystore>.jks
#   ANDROID_KEYSTORE_PASSWORD_PARENT
#   ANDROID_KEY_ALIAS_PARENT
#   ANDROID_KEY_PASSWORD_PARENT
# Variables:
#   RELEASE_API_BASE_URL              https://<host>/api/v1  (required)
#   ABNY_RELEASE_BUILD                'true' opts every push into the release path
#   ABNY_VERSION_CODE_OFFSET          added to github.run_number
#
# A release build requested with any of these missing turns the CI job RED. It
# is never skipped green. See docs/release/ANDROID_RELEASE_SIGNING.md §8.
