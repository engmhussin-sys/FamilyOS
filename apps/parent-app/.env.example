# Flutter does not read `.env` files natively — this project's Flutter
# apps read build-time config via `--dart-define` (see
# lib/core/config/app_config.dart's `String.fromEnvironment`). This file
# documents the equivalent values for consistency with the other
# projects' real `.env.example` files — copy these into your own build
# command, they are not loaded automatically.

# Example:
#   flutter run --dart-define=API_BASE_URL=http://localhost:3000/api/v1

API_BASE_URL="http://localhost:3000/api/v1"
