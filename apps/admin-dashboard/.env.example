# Copy to .env.local (git-ignored). Vite reads it once, at dev-server startup.
#
# There is deliberately no admin key here. The internal admin secret is NOT a
# build-time variable: anything named VITE_* is inlined into the JavaScript
# bundle and shipped to every visitor. The operator types the key into the
# unlock screen at runtime instead, and it is held in memory only.
# INCLUDE THE `/api/v1` PREFIX. The backend serves every route except
# /health/live and /health/ready under it (see the API_GLOBAL_PREFIX constant
# in apps/backend/src/common/http/global-pipeline.ts). Without the suffix the
# dashboard's very first call — POST /auth/login — 404s, and every panel
# reports an error that looks like a backend fault.
VITE_API_BASE_URL=http://localhost:3000/api/v1
