# Copy to .env.local (git-ignored). Vite reads it once, at dev-server startup.
#
# There is deliberately no admin key here. The internal admin secret is NOT a
# build-time variable: anything named VITE_* is inlined into the JavaScript
# bundle and shipped to every visitor. The operator types the key into the
# unlock screen at runtime instead, and it is held in memory only.
VITE_API_BASE_URL=http://localhost:3000
