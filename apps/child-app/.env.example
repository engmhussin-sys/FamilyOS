# Flutter does not read `.env` files natively — see
# lib/core/config/app_config.dart's `String.fromEnvironment`. This file
# documents the equivalent `--dart-define` values.

# Example:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000/api/v1
#
# IMPORTANT: 10.0.2.2 is the Android EMULATOR's alias for the host
# machine's localhost — NOT "localhost" itself, which inside the
# emulator refers to the emulator, not the machine running the backend.
# On a physical device on the same wifi network, use the host machine's
# real LAN IP instead (e.g. http://192.168.1.50:3000/api/v1).

API_BASE_URL="http://10.0.2.2:3000/api/v1"
