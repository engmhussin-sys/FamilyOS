# Copy to .env and adjust for your environment. Never commit the real .env.

DATABASE_URL="postgresql://afdc:afdc_dev_password@localhost:5432/afdc_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Must be two DIFFERENT values, each at least 32 characters (enforced at
# startup by src/config/env.validation.ts). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-plus-character-secret"

# 32-byte key (base64) used to encrypt LocationEvent lat/lng before
# persisting. Generate with: openssl rand -base64 32
LOCATION_ENCRYPTION_KEY="change-me"

# Origins allowed by CORS, comma-separated. Empty = no origins allowed
# (main.ts's default), not "allow everything" — set this explicitly.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# --- Optional: AI (the app boots and runs fully without this; AI
# features degrade to deterministic fallback text per the AI Core's own
# design — see docs/architecture/RELEASE_ARCHITECTURE_FREEZE.md) ---
ANTHROPIC_API_KEY=""
AI_ASSISTANT_MODEL="claude-sonnet-5"

# --- Optional: Billing providers (ManualPaymentAdapter works with none
# of these set — see docs/release/PRODUCTION_DEPLOYMENT_GUIDE.md) ---
STRIPE_SECRET_KEY=""
PAYMOB_API_KEY=""
FAWRY_API_KEY=""
APPLE_IAP_SHARED_SECRET=""
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=""

# --- Optional: Analytics (self-hosted analytics works with none of
# these set) ---
POSTHOG_API_KEY=""

# --- Optional: Observability (Sprint 4 — the backend runs fully
# without this; errors are still logged locally via the existing
# GlobalExceptionFilter/LoggingInterceptor, just not reported to
# Sentry). Create a real Sentry project, then paste its DSN here. ---
SENTRY_DSN=""

# --- Optional: Push Notifications (Sprint 5 — PushNotificationService
# safely no-ops without this, logging once at boot). Must be the FULL
# JSON service-account key from a real Firebase project's console
# (Project Settings > Service Accounts > Generate New Private Key),
# collapsed to a single line. ---
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- CRITICAL (closes a real business-metrics-exposure gap): shared
# secret required to access /analytics/dashboard-metrics and
# GET /support (internal team endpoints). Without this set, both
# endpoints fail CLOSED (deny everyone) rather than open — generate
# with: openssl rand -hex 32. Sent as the X-Internal-Admin-Key header. ---
INTERNAL_ADMIN_API_KEY=""

# --- Stripe webhook signing secret (closes a real gap: payment
# webhook architecture was confirmed genuinely missing). Without this
# set, POST /webhooks/stripe fails CLOSED (rejects every request)
# rather than skipping verification. Obtained from the Stripe
# Dashboard once a webhook endpoint is registered there pointing at
# https://<your-deployment>/webhooks/stripe. ---
STRIPE_WEBHOOK_SECRET=""

# --- Optional: set by CI/deploy pipeline, surfaced in GET /system/diagnostics ---
GIT_COMMIT_SHA=""
NODE_ENV="development"
PORT="3000"
