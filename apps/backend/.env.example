# Copy to .env and adjust for your environment. Never commit the real .env.

DATABASE_URL="postgresql://afdc:afdc_dev_password@localhost:5432/afdc_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Must be two DIFFERENT values, each at least 32 characters (enforced at
# startup by src/config/env.validation.ts). Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-plus-character-secret"

# 32-byte key (base64) used to encrypt LocationEvent lat/lng before
# persisting. Generate with: openssl rand -base64 32
LOCATION_ENCRYPTION_KEY="change-me"

# Origins allowed by CORS, comma-separated. Empty = no origins allowed
# (main.ts's default), not "allow everything" — set this explicitly.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# --- Optional: AI (the app boots and runs fully without this; AI
# features degrade to deterministic fallback text per the AI Core's own
# design — see docs/architecture/RELEASE_ARCHITECTURE_FREEZE.md) ---
ANTHROPIC_API_KEY=""
AI_ASSISTANT_MODEL="claude-sonnet-5"

# B8 (PA-B-027) — the SECONDARY ring of the provider chain. CONTEXT §2 locks
# «Anthropic Primary، OpenAI Fallback»; before B8 only the primary was wired.
# Leaving these empty is a supported configuration: FallbackAiProvider SKIPS an
# unconfigured ring rather than failing it, so a single-provider deployment
# behaves exactly as it did before. Setting them buys real failover — an
# Anthropic outage stops taking /ai-assistant/ask down with it.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Override only for a proxy or an OpenAI-compatible gateway.
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Optional: Billing providers (ManualPaymentAdapter works with none
# of these set — see docs/release/PRODUCTION_DEPLOYMENT_GUIDE.md) ---
STRIPE_SECRET_KEY=""
PAYMOB_API_KEY=""

# PHASE D — SUPERSEDED, DELIBERATELY NOT DELETED.
#
# The three variables below belonged to the Sprint 8 stub adapters, which
# needed a single opaque secret each because they never actually called
# anything. Real server-side verification needs more: Apple needs an issuer id,
# a key id, a .p8 and a pinned root fingerprint; Google needs a service-account
# pair, a package name and Pub/Sub push identities; Fawry needs a merchant code
# AND a security key. All of those are in the PHASE D section at the bottom of
# this file.
#
# They are left here, commented, rather than removed — so an operator who
# already has one set in a deployment sees WHERE IT WENT, instead of
# discovering that payments quietly stopped being configured.
#
#   FAWRY_API_KEY                    -> FAWRY_MERCHANT_CODE + FAWRY_SECURITY_KEY
#   APPLE_IAP_SHARED_SECRET          -> APPLE_ISSUER_ID / APPLE_KEY_ID /
#                                       APPLE_PRIVATE_KEY / APPLE_BUNDLE_ID /
#                                       APPLE_ROOT_CA_G3_FINGERPRINT
#   GOOGLE_PLAY_SERVICE_ACCOUNT_KEY  -> GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL +
#                                       GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY +
#                                       GOOGLE_PLAY_PACKAGE_NAME
#
# APPLE_IAP_SHARED_SECRET is specifically the LEGACY `verifyReceipt` secret.
# Apple's current model — StoreKit 2 plus the App Store Server API — does not
# use a shared secret at all; it uses asymmetric JWS verification, which is why
# the replacement is five variables rather than one.
#FAWRY_API_KEY=""
#APPLE_IAP_SHARED_SECRET=""
#GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=""

# --- Optional: Analytics (self-hosted analytics works with none of
# these set) ---
POSTHOG_API_KEY=""

# --- Optional: Observability (Sprint 4 — the backend runs fully
# without this; errors are still logged locally via the existing
# GlobalExceptionFilter/LoggingInterceptor, just not reported to
# Sentry). Create a real Sentry project, then paste its DSN here. ---
SENTRY_DSN=""

# --- Optional: Push Notifications (Sprint 5 — PushNotificationService
# safely no-ops without this, logging once at boot). Must be the FULL
# JSON service-account key from a real Firebase project's console
# (Project Settings > Service Accounts > Generate New Private Key),
# collapsed to a single line. ---
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- CRITICAL (closes a real business-metrics-exposure gap): shared
# secret required to access /analytics/dashboard-metrics and
# GET /support (internal team endpoints). Without this set, both
# endpoints fail CLOSED (deny everyone) rather than open — generate
# with: openssl rand -hex 32. Sent as the X-Internal-Admin-Key header. ---
INTERNAL_ADMIN_API_KEY=""

# --- Stripe webhook signing secret (closes a real gap: payment
# webhook architecture was confirmed genuinely missing). Without this
# set, POST /webhooks/stripe fails CLOSED (rejects every request)
# rather than skipping verification. Obtained from the Stripe
# Dashboard once a webhook endpoint is registered there pointing at
# https://<your-deployment>/webhooks/stripe. ---
STRIPE_WEBHOOK_SECRET=""

# --- Optional: set by CI/deploy pipeline, surfaced in GET /system/diagnostics ---
GIT_COMMIT_SHA=""
NODE_ENV="development"
PORT="3000"

# =============================================================================
# PHASE D — COMMERCIAL SUBSCRIPTION & PAYMENTS
#
# EVERY VALUE BELOW IS EMPTY, AND THAT IS THE POINT. Not one credential in this
# section has been fabricated. Each adapter reports `isConfigured() === false`
# while its variables are blank, throws a typed 503
# (`PaymentProviderNotConfiguredException`) from anything that would call the
# provider, and returns `{verified: false}` — NEVER `true` — from signature
# verification. An unconfigured deployment cannot be tricked into processing an
# unsigned callback.
#
# WHAT THE CLIENT MUST OBTAIN, per provider, is written above each block.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLE IN-APP PURCHASE (StoreKit 2 / App Store Server API)
#
# NOT Apple Pay. In-App Purchase is how Apple requires DIGITAL subscriptions to
# be sold inside an iOS app; Apple Pay is card presentment for PHYSICAL goods
# and belongs behind a gateway (see the Saudi block below). Do not conflate.
#
# WHAT THE CLIENT MUST OBTAIN — App Store Connect > Users and Access > Keys,
# "In-App Purchase" key type:
#   * Issuer ID       — one per account, shown at the top of the Keys page.
#   * Key ID          — per key, e.g. 2X9R4HXF34.
#   * The .p8 private key — DOWNLOADABLE ONCE. Store it in a secret manager;
#                       Apple will not let you download it again.
#   * The app's Bundle ID.
# And in App Store Connect > App > App Information > App Store Server
# Notifications, set the Production and Sandbox URLs to
#   https://<deployment>/webhooks/payments/apple
# -----------------------------------------------------------------------------
APPLE_ISSUER_ID=""
APPLE_KEY_ID=""
# The full PEM contents of the .p8. Literal "\n" escapes are normalised.
APPLE_PRIVATE_KEY=""
APPLE_BUNDLE_ID=""
# "true" targets api.storekit-sandbox.itunes.apple.com. Never "true" in production.
APPLE_USE_SANDBOX="false"

# THE ROOT CERTIFICATE PIN. Deliberately has NO DEFAULT.
#
# Apple signs every transaction and every notification as a JWS whose x5c chain
# ends at Apple Root CA G3. Without pinning that root, an attacker ships their
# own three-certificate chain in the header and signs any receipt they like —
# every other check still passes. This is the single most commonly skipped step
# in published integrations and it turns "verified" into decoration.
#
# There is no default because a wrong pin written from memory is WORSE than no
# pin: it fails closed in production for a reason nobody can debug, and gets
# "fixed" by deleting the check. Unconfigured, the verifier refuses every
# signature and says exactly why.
#
# OBTAIN IT ONCE, from https://www.apple.com/certificateauthority/ :
#   curl -O https://www.apple.com/certificateauthority/AppleRootCA-G3.cer
#   openssl x509 -in AppleRootCA-G3.cer -inform DER -noout -fingerprint -sha256
# Paste the value with or without colons; either form is accepted.
APPLE_ROOT_CA_G3_FINGERPRINT=""

# -----------------------------------------------------------------------------
# GOOGLE PLAY BILLING (Play Developer API v3 + Real-time Developer Notifications)
#
# WHAT THE CLIENT MUST OBTAIN:
#   * A Google Cloud project LINKED to the Play Console account.
#   * A service account in that project, granted the "View financial data" and
#     "Manage orders and subscriptions" permissions in Play Console >
#     Users and permissions. Its JSON key gives the two values below.
#   * A Pub/Sub topic, with Play Console > Monetization setup > Real-time
#     developer notifications pointing at it.
#   * A Pub/Sub PUSH subscription on that topic delivering to
#     https://<deployment>/webhooks/payments/google , configured with an OIDC
#     service account and an audience — those are the two GOOGLE_PUBSUB_* values.
#
# NOTE: Google AUTOMATICALLY REFUNDS AND CANCELS any purchase not acknowledged
# within three days. Acknowledgement happens after the entitlement is granted.
# -----------------------------------------------------------------------------
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
# The `private_key` field of the service account JSON. "\n" escapes normalised.
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_PLAY_PACKAGE_NAME=""
# The `aud` claim configured on the Pub/Sub push subscription's OIDC token.
GOOGLE_PUBSUB_AUDIENCE=""
# The service account the Pub/Sub push subscription signs its OIDC token as.
GOOGLE_PUBSUB_SERVICE_ACCOUNT=""

# -----------------------------------------------------------------------------
# PAYMOB (EGYPT) — cards + wallets + Fawry behind one integration.
#
# WHAT THE CLIENT MUST OBTAIN. Merchant onboarding is the long pole: commercial
# register, tax card, a bank account in the entity's name, signatory documents,
# and a description of the business. REALISTIC DURATION 4-8 WEEKS, up to 10.
# Delayed payment onboarding is the most frequent cause of GA date slippage in
# this market, which is why it starts in week 1 (condition C3).
#
# From the Paymob dashboard once approved:
#   * API key (Settings > Account Info)
#   * HMAC secret (Settings > Account Info) — signs the transaction callback
#   * Integration ID, per payment method (card / wallet / Fawry): each channel
#     is a separate integration id.
#
# Register the transaction-processed callback at
#   https://<deployment>/webhooks/payments/paymob
#
# ⚠ VERIFY BEFORE GO-LIVE: the ordered HMAC field list lives in ONE constant,
# `PAYMOB_HMAC_FIELDS` in paymob.provider.ts. Confirm it against Paymob's live
# HMAC documentation before the first real transaction — a mismatch fails
# CLOSED (every callback rejected), which is safe but total.
# -----------------------------------------------------------------------------
PAYMOB_HMAC_SECRET=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""

# -----------------------------------------------------------------------------
# FAWRY (EGYPT) — cash collection at kiosks, pharmacies and groceries.
#
# THE CHANNEL THAT OPENS THE UNBANKED MARKET, and the reason
# SubscriptionStatus.PENDING exists: a Fawry payment is NOT instant. The
# customer receives a reference number and may settle it tomorrow, in three
# days, or never. The subscription stays PENDING until the notification arrives.
# Fawry also CANNOT auto-debit, which is why Egypt's design is reminded manual
# renewal plus a 7-day grace period.
#
# WHAT THE CLIENT MUST OBTAIN: merchant code and security key, after the same
# 4-8 week onboarding. Register the server notification callback at
#   https://<deployment>/webhooks/payments/fawry
#
# ⚠ VERIFY BEFORE GO-LIVE: `FAWRY_SIGNATURE_FIELDS` in fawry.provider.ts.
# -----------------------------------------------------------------------------
FAWRY_MERCHANT_CODE=""
FAWRY_SECURITY_KEY=""
# "" for sandbox atfawry.fawrystaging.com, or the production base URL.
FAWRY_BASE_URL=""

# -----------------------------------------------------------------------------
# SAUDI ARABIA — the mada-capable card gateway.
#
# THE PROVIDER IS NOT YET CHOSEN. The MOYASAR_* names a SLOT: Moyasar (simplest
# integration, best documentation) or Tap (wider regional coverage), with
# HyperPay as the enterprise alternative. All three speak the same shape, so
# switching is one new class implementing IPaymentProvider plus one registry
# line — zero business-logic files change. See HUMAN DECISION REQUIRED #4.
#
# mada is MANDATORY: its absence is a stated churn cause in this market.
# Apple Pay is offered by these gateways as a CARD PRESENTMENT METHOD — that is
# the only correct place for Apple Pay in this architecture, and it is NOT the
# In-App Purchase path above.
#
# WHAT THE CLIENT MUST OBTAIN: a SAUDI commercial register, a Saudi tax
# certificate, a local bank account and signatory documents. 4-8 weeks. If
# there is no Saudi legal entity, the options are (a) establish one, (b) sell
# through the Egyptian entity in another currency and lose mada, or (c)
# sequence Egypt first — which is what the company response recommends.
#
# VAT IS NOT HERE. It is 15% in Saudi Arabia against 14% in Egypt, and it lives
# in the `countries` table as a column, read by PricingService. That is the
# point of the column.
# -----------------------------------------------------------------------------
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""
