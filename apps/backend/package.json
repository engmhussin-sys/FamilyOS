{
  "name": "@ai-family-coach/backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Family Digital Coach — Backend API (NestJS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx watch --inspect src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "ci:tenant-guard": "tsx scripts/ci/assert-tenant-scoping.ts",
    "ci:event-emission": "tsx scripts/ci/assert-event-emission.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ci:deps-current": "tsx scripts/ci/assert-dependencies-current.ts",
    "ci:runtime-deps": "tsx scripts/ci/assert-runtime-deps.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "@types/compression": "^1.8.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
