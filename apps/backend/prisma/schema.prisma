model LocationSafeZone {
  familyId  String  @map("family_id") @db.Uuid
  id            String    @id @default(uuid()) @db.Uuid
  childId       String    @map("child_id") @db.Uuid
  name          String
  zoneType      ZoneType  @map("zone_type")
  latitude      Float
  longitude     Float
  radiusMeters  Int       @map("radius_meters")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  locationEvents LocationEvent[]

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([familyId])
  @@map("location_safe_zones")
}

/// Location pings. latitude/longitude are stored ENCRYPTED at the
/// application layer (see docs/database/README.md §5) — the columns here
/// hold ciphertext, typed String rather than Float, on purpose.
/// expiresAt drives a scheduled purge job (default retention: 30 days)
/// so raw location history does not accumulate indefinitely.
model LocationEvent {
  familyId  String  @map("family_id") @db.Uuid
  id             String            @id @default(uuid()) @db.Uuid
  childId        String            @map("child_id") @db.Uuid
  deviceId       String            @map("device_id") @db.Uuid
  safeZoneId     String?           @map("safe_zone_id") @db.Uuid
  eventType      LocationEventType @map("event_type")
  latitudeEnc    String            @map("latitude_enc")
  longitudeEnc   String            @map("longitude_enc")
  accuracyMeters Float?            @map("accuracy_meters")
  recordedAt     DateTime          @map("recorded_at")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  child    Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  device   Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  safeZone LocationSafeZone? @relation(fields: [safeZoneId], references: [id])

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId, recordedAt])
  @@index([expiresAt])
  @@index([familyId])
  @@map("location_events")
}

