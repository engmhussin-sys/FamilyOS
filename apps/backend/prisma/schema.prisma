// DOMAIN: AI SAFETY & ALERTS
// ============================================================================

/// Daily aggregated safety/behavior score per child, produced by the AI
/// engine from signals (not raw conversation content). categoryBreakdown
/// holds a JSON map like {"cyberbullying": 12, "predatorRisk": 3, ...}.
/// AUTHORIZED PARTIAL AI-CORE UNFREEZE (explicit user permission,
/// scoped to AI Cost Tracking only, granted after the standing
/// architecture freeze this project maintained throughout its
/// history). CLOSES A REAL GAP: AnthropicAIProvider's own docstring
/// already logged real token usage per-call but only to structured
/// logs, not queryable storage — its own comment flagged this
/// exact gap as "a real follow-up if per-family AI cost attribution
/// is ever needed." This is that follow-up. Additive only — zero
/// change to any existing model, zero change to any AI
/// decision-making logic (Rule/Decision/Safety/Behavioral engines
/// remain completely untouched).
model AiUsageLog {
  familyId  String? @map("family_id") @db.Uuid
  id                 String   @id @default(uuid()) @db.Uuid
  model              String
  inputTokens        Int      @map("input_tokens")
  outputTokens       Int      @map("output_tokens")
  /// Computed at write-time from a fixed, reviewable per-model price
  /// table (see AiCostCalculator) — stored, not recomputed later, so
  /// historical costs remain accurate even if prices change going
  /// forward. Stored in MICRO-CENTS (1/1,000,000 of a cent), not
  /// cents — a single AI call typically costs a small fraction of one
  /// cent, and storing whole cents would round nearly every real call
  /// down to 0, silently destroying the data this table exists to
  /// capture. Aggregate (SUM) and divide by 1,000,000 for a real
  /// dollar total.
  estimatedCostMicroCents Int      @map("estimated_cost_micro_cents")
  /// Optional, honest-absence-by-default: which calling feature made
  /// this request (e.g. "ai-assistant", "recommendation-engine").
  /// Null for any caller that doesn't pass one — never a fabricated
  /// guess at which feature it was.
  sourceFeature      String?  @map("source_feature")
  createdAt          DateTime @default(now()) @map("created_at")

  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([sourceFeature, createdAt])
  @@index([familyId])
  @@index([familyId, createdAt])
  @@map("ai_usage_logs")
}

model AiRiskScore {
  familyId  String  @map("family_id") @db.Uuid
  id                String   @id @default(uuid()) @db.Uuid
  childId           String   @map("child_id") @db.Uuid
  scoreDate         DateTime @map("score_date") @db.Date
  overallScore      Int      @map("overall_score") // 0-100, higher = safer
  categoryBreakdown Json     @map("category_breakdown")
  generatedAt       DateTime @default(now()) @map("generated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([childId, scoreDate])
  @@index([childId])
  @@index([familyId])
  @@map("ai_risk_scores")
}

/// A single actionable alert surfaced to parents. This is the AI layer's
/// output contract — parents see alerts, never raw monitored content.
model AiAlert {
  familyId  String  @map("family_id") @db.Uuid
  id               String        @id @default(uuid()) @db.Uuid
  childId          String        @map("child_id") @db.Uuid
  category         AlertCategory
  severity         AlertSeverity
  title            String
  description      String
  sourceModule     String        @map("source_module") // e.g. "keyboard-behavior-ai"
  /// WHAT MAKES THIS ALERT THE SAME ALERT (migration 0027). Composed by the
  /// PRODUCER — the only layer that knows what caused the detection — and held
  /// by the unique index below, so a REPLAYED detection is refused by
  /// PostgreSQL rather than by a `findFirst` that cannot see a concurrent
  /// writer. Deliberately the same column name, and the same discipline, as
  /// `notifications.source_event_id`. SERVER-INTERNAL: no parent-facing
  /// payload returns it, and no producer may put a child's words in it.
  sourceEventId    String        @map("source_event_id") @db.VarChar(200)
  status           AlertStatus   @default(NEW)
  /// SPRINT F2. WHO REVIEWED IT — and it is an OPERATOR, not a parent.
  ///
  /// This replaces `reviewedByUserId`, which pointed at `users`, had NO WRITER
  /// anywhere in `src/` for the entire life of this product, and was therefore
  /// a reviewer column for a review flow that did not exist. Measured before
  /// removing it: zero writers, zero readers in `src/`, one test asserting it
  /// null. Nothing was lost because nothing was ever stored.
  ///
  /// Reviewing a child-distress signal is the safety desk's job, and the safety
  /// desk is staff. Not a foreign key, for the same reason `audit_logs` has
  /// none: this row must survive the reviewer's departure, and a safety record
  /// may never be the reason a deletion is refused or, worse, cascades.
  reviewedByOperatorId String?   @map("reviewed_by_operator_id") @db.Uuid
  reviewedAt       DateTime?     @map("reviewed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  child          Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  notes          AiAlertNote[]

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, sourceEventId])
  @@index([childId, status])
  @@index([severity])
  @@index([familyId])
  /// The queue's own order: everything unreviewed, worst and oldest first.
  /// Cross-tenant by construction — the safety desk works one queue, not one
  /// household — which is why it is not prefixed by `family_id`.
  @@index([status, severity, createdAt])
  @@map("ai_alerts")
}

// ============================================================================
// CROSS-CUTTING: AUDIT & NOTIFICATIONS
// ============================================================================

/// Append-only. Never updated or soft-deleted — this is the compliance
/// trail (GDPR "right to access", security incident investigation).
/// ===========================================================================
/// A MEMBER OF THIS PLATFORM'S STAFF, AS A ROW.
/// ===========================================================================
///
/// WHAT IT REPLACES. One shared `INTERNAL_ADMIN_API_KEY`, held in every
/// operator's browser memory, which was simultaneously the authentication, the
/// authorization and the identity of all forty-five operator routes. Three
/// consequences, none of them acceptable past a team of one:
///
///   NOBODY COULD BE NAMED. Every audit row said SYSTEM. «Which of my staff
///   suspended this account» had no answer anywhere in the database.
///   NOBODY COULD BE REMOVED. Revoking one person's access meant rotating the
///   key and re-issuing it to everyone else.
///   EVERYBODY COULD DO EVERYTHING. `@PlatformAdminSurface()` is one role, so
///   a support agent reading a ticket held the same key that edits prices.
///
/// THE SHARED KEY IS NOT DELETED — it becomes the OUTER gate, the thing that
/// says «this request reached the console at all». This table is the inner one,
/// and it is the one that has a name.
///
/// NOT A `User`. An operator is staff, not a member of a household: they have
/// no family, no children, no subscription, and they must never be resolvable
/// by the family-facing login. Putting them in `users` would mean one row that
/// two entirely different authentication paths both accept, which is the shape
/// of every privilege-escalation bug ever written.
model Operator {
  id           String         @id @default(uuid()) @db.Uuid
  /// Lowercased at the service boundary so a login cannot be case-shadowed.
  email        String         @unique
  fullName     String         @map("full_name")
  role         OperatorRole
  /// Argon2id, the same PasswordService the family surface uses. Never a
  /// shared secret and never reversible.
  passwordHash String         @map("password_hash")
  status       OperatorStatus @default(ACTIVE)
  lastLoginAt  DateTime?      @map("last_login_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  /// Set once and never cleared. Revocation is a fact about a person's access
  /// that an audit trail must keep, so this is a tombstone rather than a
  /// delete: the audit rows they wrote still name an operator that exists.
  revokedAt    DateTime?      @map("revoked_at")

  @@index([status])
  @@map("operators")
}

/// FOUR ROLES, NOT SEVEN, and the shortfall is deliberate. A role with no
/// holder is a permission matrix nobody exercises and no test defends; the
/// three that were proposed and left out (OPERATIONS, BILLING, ANALYST) can be
/// added the day a real person needs one, and `permissions.ts` is written so
/// that adding one is a single map entry.
enum OperatorRole {
  /// Everything, including managing other operators.
  SUPER_ADMIN
  /// Reads households, works the support queue, reads safety METADATA.
  SUPPORT
  /// The child-safety desk: the only role that may read a safety alert's
  /// CONTENT, and the only one that may review, escalate or resolve one.
  SAFETY
  /// Reads. Writes nothing, anywhere. For analysts and for auditors.
  READ_ONLY
}

enum OperatorStatus {
  ACTIVE
  /// Temporarily barred; sessions are killed immediately and login refuses.
  SUSPENDED
  /// Permanently barred. `revokedAt` carries the instant.
  REVOKED
}

model AuditLog {
  familyId  String? @map("family_id") @db.Uuid
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action     String // e.g. "child.consent.revoked", "device.paired"
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// SPRINT F2 — WHICH MEMBER OF STAFF. Null for every non-operator actor, and
  /// that is the honest value: a login by a parent has no operator.
  operatorId    String?       @map("operator_id") @db.Uuid
  /// DENORMALISED ON PURPOSE, both of them. An operator can be renamed, have
  /// their role changed, or be revoked entirely; an audit row must say who they
  /// WERE AND WHAT THEY HELD AT THE INSTANT THEY ACTED. Joining to `operators`
  /// for the answer would silently rewrite history every time a role changed.
  operatorEmail String?       @map("operator_email")
  operatorRole  OperatorRole? @map("operator_role")
  /// WHY. Mandatory for every operator mutation, enforced in the service rather
  /// than by a NOT NULL, because the same table also stores `auth.login`, which
  /// has no reason and should not be forced to invent one.
  reason        String?
  /// Correlates this row with the request that produced it, and with anything
  /// else that request wrote.
  requestId     String?       @map("request_id")

  /// NOT ADDED, DELIBERATELY: `before`, `after`, `userAgent`, `result`. Each was
  /// specified and each would have had NO WRITER in this slice, and a nullable
  /// column whose only writer is «nothing yet» is precisely what this
  /// repository's dormancy ledger exists to refuse. They land with the
  /// mutations that actually record them.

  actorUser User? @relation("AuditActorUser", fields: [actorUserId], references: [id])

  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([familyId])
  @@index([familyId, createdAt])
  /// «Everything this member of staff has ever done», which is the query a
  /// compliance review opens with. A JSON scan could not answer it.
  @@index([operatorId, createdAt])
  @@map("audit_logs")
}

/// AN OPERATOR'S NOTE ON A SAFETY ALERT.
///
/// WHY IT EXISTS: an escalation with no words is unactionable. «Escalated» tells
/// the next person that somebody was worried and nothing about why, and the
/// person who escalated it has usually gone home.
///
/// WHY IT IS ITS OWN TABLE AND NOT A COLUMN: notes accumulate, they are written
/// by different people at different times, and each one must carry its own
/// author and instant. A single `notes` column would be a field that the second
/// writer overwrites the first in.
///
/// IT IS APPEND-ONLY BY CONSTRUCTION — no update, no delete, anywhere in `src/`.
/// The directive is explicit that an operator may not delete safety history, and
/// a note explaining why an alert was dismissed is exactly the history somebody
/// would later want gone.
model AiAlertNote {
  familyId   String   @map("family_id") @db.Uuid
  id         String   @id @default(uuid()) @db.Uuid
  alertId    String   @map("alert_id") @db.Uuid
  /// Denormalised, like every operator reference in this schema: the note must
  /// still name its author after that author is revoked.
  operatorId    String @map("operator_id") @db.Uuid
  operatorEmail String @map("operator_email")
  /// The status this note was written ALONGSIDE, so the trail reads as a story
  /// rather than as a pile of comments.
  transitionTo AlertStatus? @map("transition_to")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  alert  AiAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  family Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@index([familyId])
  @@map("ai_alert_notes")
}

model AiMemoryEntry {
  familyId  String  @map("family_id") @db.Uuid
  id        String   @id @default(uuid()) @db.Uuid
  childId   String   @map("child_id") @db.Uuid
  /// HABIT | PREFERENCE | VIOLATION | RECOMMENDATION | CONFIDENCE —
  /// Sprint 7's explicit memory categories. Plain string, not an enum:
  /// this table is meant to grow new categories (Health/Education
  /// engines, later) without a schema migration per category.
  category  String
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([childId, category, key])
  @@index([childId, category])
  @@index([familyId])
  @@map("ai_memory_entries")
}

/// Sprint 8 — the price/feature definition PER TIER. Deliberately named
/// PlanDefinition, not "SubscriptionPlan" (that name is the pre-existing
/// enum on Family) — one row per SubscriptionPlan enum value, seeded
/// once, admin-editable later.
model PlanDefinition {
  id                     String           @id @default(uuid()) @db.Uuid
  tier                   SubscriptionPlan @unique
  name                   String
  priceCents             Int              @map("price_cents")
  currency               String           @default("USD")
  billingIntervalMonths  Int              @default(1) @map("billing_interval_months")
  /// Array of entitlement keys this tier grants, e.g.
  /// ["ai_diagnostics", "family_insights", "multiple_children"] —
  /// EntitlementsService checks membership in this list, nowhere else.
  features               Json
  isActive               Boolean          @default(true) @map("is_active")
  createdAt              DateTime         @default(now()) @map("created_at")

  @@map("plan_definitions")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  familyId               String             @unique @map("family_id") @db.Uuid
  planTier               SubscriptionPlan   @map("plan_tier")
  status                 SubscriptionStatus @default(TRIALING)
  provider               PaymentProvider    @default(MANUAL)
  /// The provider's own subscription identifier (e.g. Stripe's `sub_...`)
  /// — null for MANUAL and until a real provider is configured.
  providerSubscriptionId String?            @map("provider_subscription_id")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  canceledAt             DateTime?          @map("canceled_at")
  /// CLOSES A REAL GAP (previously explicitly flagged: "DISCOUNT
  /// codes are not yet supported"). DELIBERATE SCOPE: a percentage
  /// discount (0-100), applied ONCE to the next invoice
  /// createDraftInvoice generates, then cleared to null — the
  /// simplest coherent semantic. NOT a recurring discount, NOT
  /// stackable with another code (redeeming a second DISCOUNT code
  /// simply overwrites this value) — those are real, separate
  /// product decisions this migration does not make.
  pendingDiscountPercent Int?               @map("pending_discount_percent")

  // ---- PHASE D additions. All nullable; every pre-Phase-D row stays valid. ----
  /// ISO-3166-1 alpha-2. Which market's price list this subscription was sold
  /// from. NULL on rows created before Phase D.
  countryCode            String?            @map("country_code") @db.VarChar(2)
  /// ISO-4217, frozen at purchase. A family that bought in EGP is billed in
  /// EGP even if it later moves country — changing the currency of a live
  /// subscription is a re-purchase, not an UPDATE.
  currencyCode           String?            @map("currency_code") @db.VarChar(3)
  billingPeriod          BillingPeriod?     @map("billing_period")
  /// The exact `subscription_prices` row this was sold at. Lets a price change
  /// be rolled out without silently re-pricing live subscriptions.
  subscriptionPriceId    String?            @map("subscription_price_id") @db.Uuid
  /// End of the non-punitive grace window (Q17: 7 days after failure/expiry).
  gracePeriodEndsAt      DateTime?          @map("grace_period_ends_at")
  /// Whether the provider will attempt another charge. FALSE for Egypt's
  /// manual-renewal design and for a cancelled store subscription that has
  /// not yet expired.
  autoRenewing           Boolean            @default(false) @map("auto_renewing")
  /// Apple `originalTransactionId` / Google `purchaseToken` — the durable
  /// lineage key a store uses across renewals, which is NOT the same thing as
  /// `provider_subscription_id` (Stripe's `sub_...`).
  providerOriginalTransactionId String?     @map("provider_original_transaction_id") @db.VarChar(200)
  /// Apple productId / Google basePlanId this subscription currently resolves to.
  providerProductId      String?            @map("provider_product_id") @db.VarChar(120)
  /// THE OUT-OF-ORDER GUARD. `00-Company-Response.md` Q17: «the older event
  /// does not overwrite the newer». Every webhook handler compares the
  /// provider's own signed timestamp against this column and drops anything
  /// not strictly newer. Arrival order is not causal order.
  lastProviderEventAt    DateTime?          @map("last_provider_event_at")

  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  paymentTransactions PaymentTransaction[]
  entitlements        Entitlement[]

  @@index([providerOriginalTransactionId])
  @@map("subscriptions")
}

model Invoice {
  familyId  String  @map("family_id") @db.Uuid
  id                String        @id @default(uuid()) @db.Uuid
  subscriptionId    String        @map("subscription_id") @db.Uuid
  amountCents       Int           @map("amount_cents")
  currency          String        @default("USD")
  status            InvoiceStatus @default(DRAFT)
  providerInvoiceId String?       @map("provider_invoice_id")
  issuedAt          DateTime      @default(now()) @map("issued_at")
  paidAt            DateTime?     @map("paid_at")

  // ---- PHASE D additions. All nullable; every pre-Phase-D row stays valid. ----
  /// Human-facing document number. Sequential per family, allocated by the
  /// database (see `next_invoice_number()` in migration 0012) so two
  /// concurrent issuances cannot produce the same number.
  invoiceNumber     String?       @map("invoice_number") @db.VarChar(40)
  countryCode       String?       @map("country_code") @db.VarChar(2)
  billingPeriod     BillingPeriod? @map("billing_period")
  /// FROZEN AT ISSUANCE. A VAT rate change must not retroactively alter a
  /// document that has already been given to a customer and a tax authority.
  vatBasisPoints    Int?          @map("vat_basis_points")
  subtotalMinor     Int?          @map("subtotal_minor")
  vatMinor          Int?          @map("vat_minor")
  /// Gross total, in minor units. `amount_cents` above is retained unchanged
  /// for every existing reader; for Phase D rows the two agree.
  totalMinor        Int?          @map("total_minor")
  provider          PaymentProvider?
  paymentTransactionId String?    @map("payment_transaction_id") @db.Uuid

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([invoiceNumber])
  @@index([subscriptionId])
  @@index([familyId])
  @@index([paymentTransactionId])
  @@map("invoices")
}

/// Sprint 8 — internal Feature Flag engine's storage. Deliberately flat:
/// a flag is either globally on/off, or scoped to specific families via
/// `enabledFamilyIds`. No percentage rollout / A-B testing here (that's
/// real additional scope, not silently included).
model FeatureFlag {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  description      String
  isEnabledGlobally Boolean @default(false) @map("is_enabled_globally")
  enabledFamilyIds String[] @map("enabled_family_ids") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

/// Sprint 8 \u2014 Analytics Core's Event Store. `payload` passes through
/// PrivacyFilter (application layer) before ever reaching this table \u2014
/// no PII is stored here by construction, not by convention.
model AnalyticsEvent {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String?  @map("family_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  sessionId String   @map("session_id")
  eventName String   @map("event_name")
  payload   Json?
  occurredAt DateTime @default(now()) @map("occurred_at")
  /// PHASE F (`F6-004`, closing `PF-E-004`) — the CAUSE this row counts, for
  /// the bus-derived growth events only. `null` for the open
  /// `POST /analytics/track` surface, which has no cause and is not
  /// deduplicated. The partial unique index that makes redelivery a no-op
  /// lives in migration 0020 — Prisma cannot express a partial index, and
  /// declaring a plain `@@unique` here would generate a TOTAL one that
  /// collapsed every ad-hoc event with a NULL cause into a single row.
  sourceEventId String? @map("source_event_id")

  @@index([eventName, occurredAt])
  @@index([familyId])
  @@map("analytics_events")
}

/// ============================================================
/// ORGANIZATION PLATFORM (Sprint 9 addendum \u2014 architecture direction
/// only, per the explicit "database direction, not full system" scope).
/// See docs/architecture/ORGANIZATION_PLATFORM_ARCHITECTURE.md for the
/// full reasoning. THREE hard constraints honored here:
///   1. Zero foreign key FROM any existing table INTO these new ones \u2014
///      Family/FamilyMember/Child/etc. are completely untouched.
///   2. Zero foreign key FROM these new tables INTO Family \u2014 this is a
///      parallel, currently-unused structure, not a live migration.
///   3. Government is NOT in this enum \u2014 explicitly out of v1 scope
///      per the product decision; adding it later is a safe additive
///      enum value when v2 arrives.
/// ============================================================

enum OrganizationType {
  FAMILY
  SCHOOL
  COMPANY
  BANK
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PartnerCampaignType {
  REFERRAL
  COUPON
  TRIAL_EXTENSION
  DISCOUNT
  QR_CODE
}

/// The generalized tenant. `Family` is NOT migrated to this table in
/// this sprint \u2014 the eventual convergence path (documented in the ADR)
/// is that a Family becomes `Organization{type: FAMILY}` with a matching
/// `id`, backfilled in a dedicated future migration, not here. Until
/// that migration runs, this table has zero rows and zero readers.
model Organization {
  id                   String            @id @default(uuid()) @db.Uuid
  type                 OrganizationType
  name                 String
  /// Self-referential, for School→Department or Company→Branch
  /// hierarchies. Null for a top-level org (including every Family).
  parentOrganizationId String?           @map("parent_organization_id") @db.Uuid
  /// White-label branding + per-org feature toggles (Sprint 9's White
  /// Label direction) \u2014 shape intentionally loose (Json) since the
  /// concrete fields (logo URL, color scheme, enabled modules) are a
  /// product decision for whoever builds the White Label config UI,
  /// not an architecture-layer concern.
  settings             Json?
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  parentOrganization   Organization?     @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations   Organization[]    @relation("OrganizationHierarchy")
  members              OrganizationMember[]
  policies             OrganizationPolicy[]
  invitations          OrganizationInvitation[]
  partnerCampaigns     PartnerCampaign[]

  @@index([type])
  @@index([parentOrganizationId])
  @@map("organizations")
}

/// Generalizes FamilyMember's role concept across every organization
/// type. NOT wired to replace FamilyMember in this sprint.
model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  deletedAt      DateTime?        @map("deleted_at")

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// Generalizes the pattern ScreenTimePolicy already established (a
/// versioned, per-owner policy row) to the organization level \u2014 e.g. a
/// School setting a default screen-time policy for all its students'
/// Family sub-organizations, or a Bank setting a compliance policy for
/// all employee accounts. Deliberately Json-valued and key-based (not
/// one column per policy type) so School/Company/Bank policies \u2014
/// which don't exist yet and shouldn't be guessed at schema level \u2014
/// don't require a migration each time a new policy type is invented.
model OrganizationPolicy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  key            String
  value          Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_policies")
}

/// Generalizes the invite-a-member concept (distinct from Pairing's
/// device-invite flow, which stays exactly as-is \u2014 this is for
/// inviting a HUMAN to join an Organization as a member, e.g. a
/// School admin inviting a teacher).
model OrganizationInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  email           String
  role            OrganizationRole @default(MEMBER)
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("organization_invitations")
}

/// Partner Program (Sprint 9 direction): a campaign is always owned by
/// an Organization (the partner) \u2014 no separate Partner entity needed,
/// since a partner IS an Organization (of any type) with campaigns
/// attached. `config` shape varies by `type` (discount percentage for
/// DISCOUNT, trial-day extension for TRIAL_EXTENSION, etc.) \u2014 Json by
/// design, same reasoning as OrganizationPolicy.value.
model PartnerCampaign {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  code           String              @unique
  type           PartnerCampaignType
  config         Json
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  expiresAt      DateTime?           @map("expires_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([code])
  @@map("partner_campaigns")
}

model Notification {
  familyId  String  @map("family_id") @db.Uuid
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  childId   String?   @map("child_id") @db.Uuid
  type      String
  title     String
  body      String
  data      Json?
  /// CLOSES A REAL GAP (Master Completeness Audit): zero priority
  /// concept existed anywhere in the notification system. String
  /// (not enum) matching this schema's own established pattern for
  /// open-ended classification fields (Child.type, etc.) — the real
  /// priority vocabulary depends on which callers exist, a product
  /// decision made at the call site (NotificationsService), not
  /// hardcoded into the schema layer.
  priority  String    @default("NORMAL")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// B9 (PA-B-007 / PA-B-008). THE COLUMN WHOSE ABSENCE WAS THE DEFECT.
  ///
  /// Every other link in the chain CONTEXT §5 describes — device event, outbox
  /// message, consumer marker, ledger row — is protected by a UNIQUE index.
  /// This row was protected by a `findFirst` over a five-minute window, which
  /// is not a constraint: delete the consumption marker, wait six minutes,
  /// redeliver, and one reward notified twice. The project's own «KNOWN LIMIT»
  /// test measured exactly that (notificationCount = 2).
  ///
  /// This is the CAUSAL KEY of the notification, composed deliberately by each
  /// producer (`src/shared/notifications/notification-source-key.ts`). For the
  /// outbox path it is the `domain_events.id` that caused it, so it is stable
  /// across every redelivery for all time; for the paths that have no domain
  /// event it is a stated, documented composition. NOT NULL on purpose — a
  /// nullable column lets a future producer opt out of the constraint by
  /// forgetting, and forgetting is the failure mode a constraint exists to
  /// remove.
  sourceEventId String @map("source_event_id") @db.VarChar(200)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  /// B9 — THE CONSTRAINT. `user_id` IS in the key and `type` is NOT; both
  /// halves are deliberate.
  ///
  ///   `user_id` is in it because delivery is PER RECIPIENT. Today
  ///   `createForFamilyOwner` writes one row, for the owner, and its own
  ///   docstring names all-member fanout as a real follow-up. With `user_id`
  ///   in the key that fanout is additive; without it the follow-up would have
  ///   to WEAKEN this index in order to ship, which is how constraints die.
  ///
  ///   `type` is NOT in it because the declared rule is «one business event =>
  ///   one notification», not «one per type». Putting `type` in the key would
  ///   re-create PA-B-011 at the database level: four types from one event,
  ///   four rows, all legal. A producer that genuinely needs two notifications
  ///   from one event says so by composing two different source keys —
  ///   visibly, at the call site.
  @@unique([familyId, sourceEventId, userId])
  @@index([userId, readAt])
  @@index([childId, createdAt])
  @@index([familyId])
  @@map("notifications")
}

// ============================================================
// Life Intelligence Platform — Architecture 1.0 (Sprint 13)
// Every model below is ADDITIVE. Zero existing model touched.
// ============================================================

enum SmartTaskStatus {
  SUGGESTED
  ACCEPTED
  COMPLETED
  DISMISSED
}

/// F4 — EXTENDED, NOT REPLACED. `XP`/`COINS`/`BADGE` are untouched, so every
/// existing reader, every existing ledger row and every existing CHECK
/// constraint keeps working. The six values below are added with
/// `ALTER TYPE ... ADD VALUE` in migration 0006 (additive, no rewrite).
///
/// `POINTS` is deliberately ABSENT: the product word "نقطة" maps onto the
/// existing `XP` value rather than becoming a second currency next to it
/// (CONTEXT §3 principle 1). See `src/shared/rewards/reward-spec.ts`.
enum RewardType {
  XP
  COINS
  BADGE
  SCREEN_TIME
  PHYSICAL_REWARD
  DIGITAL_REWARD
  PRIVILEGE
  PARENT_APPROVAL_REWARD
  CUSTOM_REWARD
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  DENIED
  FULFILLED
}

enum MessageAuthorType {
  PARENT
  AI
}

enum MessageApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ActivitySocialContext {
  SOLO
  GROUP
  TEAM
}

enum TimelineCategory {
  HEALTH
  LEARNING
  FAITH
  REWARDS
  SAFETY
  HABITS
  FAMILY
}

/// Habit Builder — a parent-defined (or built-in) recurring daily task.
/// Deliberately STATIC — AI-generated dynamic suggestions are a
/// separate, later concern (Smart Tasks Engine, not built this sprint).
model Habit {
  familyId  String  @map("family_id") @db.Uuid
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @map("child_id") @db.Uuid
  title       String
  category    String
  /// Sprint 16 (Smart Daily Life Layer) — CLOSES A REAL GAP: Daily
  /// Tasks Engine requires description/scheduling/priority, none of
  /// which existed on Habit before this. All nullable/defaulted —
  /// every existing habit row remains valid without a data migration
  /// beyond adding the columns themselves.
  description String?
  /// "HH:MM" 24h local time, e.g. "07:30" — the start of the
  /// scheduled window this task is meant for (e.g. morning routine
  /// vs. evening). Null means "no specific time — anytime today",
  /// an honest absence, not a fabricated default time.
