/// Habit Builder — a parent-defined (or built-in) recurring daily task.
/// Deliberately STATIC — AI-generated dynamic suggestions are a
/// separate, later concern (Smart Tasks Engine, not built this sprint).
model Habit {
  familyId  String  @map("family_id") @db.Uuid
  id          String   @id @default(uuid()) @db.Uuid
  childId     String   @map("child_id") @db.Uuid
  title       String
  category    String
  /// Sprint 16 (Smart Daily Life Layer) — CLOSES A REAL GAP: Daily
  /// Tasks Engine requires description/scheduling/priority, none of
  /// which existed on Habit before this. All nullable/defaulted —
  /// every existing habit row remains valid without a data migration
  /// beyond adding the columns themselves.
  description String?
  /// "HH:MM" 24h local time, e.g. "07:30" — the start of the
  /// scheduled window this task is meant for (e.g. morning routine
  /// vs. evening). Null means "no specific time — anytime today",
  /// an honest absence, not a fabricated default time.
  scheduledStartTime String? @map("scheduled_start_time")
  scheduledEndTime   String? @map("scheduled_end_time")
  /// String, not enum — same "grows without migration" reasoning
  /// this schema already uses for `category` itself. Real values in
  /// use: DAILY, WEEKLY, SPECIFIC_DAYS (paired with
  /// recurrenceDaysOfWeek below).
  recurrence  String   @default("DAILY")
  /// 0-6 (Sunday-Saturday), only meaningful when recurrence is
  /// SPECIFIC_DAYS — null otherwise.
  recurrenceDaysOfWeek Int[] @default([]) @map("recurrence_days_of_week")
  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH — a plain string, same reasoning as category
  /// Whether a parent authored this (custom) or it's a built-in
  /// default — mirrors AiMemoryEntry.category's "plain string, grows
  /// without migration" reasoning: category is a string, not an enum.
  isCustom    Boolean  @default(true) @map("is_custom")
  isShared    Boolean  @default(false) @map("is_shared") // family/shared task — Social Score input
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  completions HabitCompletion[]

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId, isActive])
  @@index([familyId])
  @@map("habits")
}

