/// Append-only ledger — mirrors AuditLog's own append-only discipline.
model RewardsLedgerEntry {
  familyId  String  @map("family_id") @db.Uuid
  id        String     @id @default(uuid()) @db.Uuid
  childId   String     @map("child_id") @db.Uuid
  type      String     // 'EARN' | 'REDEEM'
  rewardType RewardType @map("reward_type")
  /// UNSIGNED magnitude, kept for backward compatibility with every
  /// existing reader. Direction lives in `type`, which is exactly why
  /// `SUM(amount)` could never reconstruct a balance (A2 §7.4: ledger
  /// SUM = 600 while the account column said −500). Use `delta`.
  amount    Int
  /// DA-002. SIGNED movement: +amount for EARN, −amount for REDEEM.
  /// This is what makes the ledger an actual ledger — the balance of
  /// any reward type is `SUM(delta)` filtered by `reward_type`, and
  /// `RewardsAccount` becomes a reconcilable cache of that sum rather
  /// than an unverifiable source of truth (CONTEXT §3.6 / DP-5
  /// deterministic recomputation).
  delta     Int
  source    String     // e.g. 'habit_streak', 'reward_rule:<id>', 'manual:<userId>', 'redemption:<id>'
  /// Sprint 16.1 (Double Reward Protection), hardened in DA-002.
  /// The ONLY defense against double-granting is this column's unique
  /// constraint below, enforced by PostgreSQL — never an application
  /// "check then insert", which is itself a race.
  ///
  /// NOW MANDATORY (was nullable). A2 §7.3 scenario C proved the
  /// nullable design left every keyless path completely unprotected:
  /// PostgreSQL treats each NULL as distinct, so 8 concurrent keyless
  /// grants produced 8 rows. Callers that have no natural key no
  /// longer pass nothing — the repository synthesises a unique
  /// per-call key instead, which keeps manual/admin grants working
  /// while making the unique index total over the table.
  idempotencyKey String @map("idempotency_key")
  createdAt DateTime   @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([childId, idempotencyKey])
  @@index([childId, createdAt])
  @@index([familyId])
  @@map("rewards_ledger_entries")
}

