/// Reward Rules — automatic, rule-based grants (Architecture 1.0 Decision 7).
/// familyId null = built-in default rule; set = a family-specific override.
model RewardRule {
  id                  String     @id @default(uuid()) @db.Uuid
  familyId            String?    @map("family_id") @db.Uuid
  triggerEngine       String     @map("trigger_engine")
  triggerCondition     Json      @map("trigger_condition")
  rewardType           RewardType @map("reward_type")
  rewardAmountOrBadgeId String   @map("reward_amount_or_badge_id")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now()) @map("created_at")

  /// F4 — THE EXTENSION POINT, and the reason `RewardProgram` did not have to
  /// bring its own grant path. A `RewardProgram` MATERIALISES companion
  /// `RewardRule` rows (one per multiplier tier it has actually used), so the
  /// existing `evaluateRewardRules` subset-match and the existing
  /// `RewardsEngineService.processTriggerEvent` grant BOTH work unmodified —
  /// zero lines changed in either. `triggerCondition` on a companion row is
  /// `{ programId, multiplierBps }`, which is exactly what the engine already
  /// knows how to match against a trigger payload.
  programId           String?    @map("program_id") @db.Uuid
  /// 10000 = 1.00x. Present on companion rows only; NULL on hand-authored and
  /// platform rules, which is what keeps the partial unique index below from
  /// touching them.
  multiplierBps       Int?       @map("multiplier_bps")

  /// B4 (PA-B-015 · PA-B-013) — THE MANAGEMENT COLUMNS.
  ///
  /// `eventType` is the load-bearing one. A rule used to match on
  /// `triggerEngine` alone, so ONE habit-builder rule matched BOTH the keyed
  /// `HABIT_COMPLETED` trigger and the legacy keyless `habit_completed` trigger
  /// that the same engine still fires — two ledger rows for one completion, and
  /// the keyless one carried a `nokey:<uuid>` key no unique index can catch.
  /// A rule that names its event type matches exactly one of them.
  ///
  /// NULL = wildcard, the pre-B4 behaviour, kept because F4 companion rows are
  /// matched by `{programId, multiplierBps}` and must stay untouched.
  eventType           String?    @map("event_type") @db.VarChar(60)
  /// FK into `reward_program_categories.code` — a TABLE, never a PostgreSQL
  /// enum, so the client's category list grows by INSERT. NULL on F4 companion
  /// rows (the PROGRAM carries the category there).
  category            String?    @map("category") @db.VarChar(40)
  labelAr             String?    @map("label_ar")
  /// Counted on the FAMILY's business day / business week
  /// (`FamilyDateService.getBusinessDayRange`), never on UTC and never on the
  /// container clock. NULL = uncapped.
  maxPerDay           Int?       @map("max_per_day")
  maxPerWeek          Int?       @map("max_per_week")
  /// SELF | SENSOR | SYSTEM | PARENT — the weakest evidence this rule will pay
  /// for. Compared against `CompletionEvent.verifiedBy`. NULL = accept any.
  minVerifiedBy       String?    @map("min_verified_by") @db.VarChar(10)
  createdByUserId     String?    @map("created_by_user_id") @db.Uuid
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at")

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  program RewardProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  categoryRef RewardProgramCategory? @relation(fields: [category], references: [code])

  @@index([familyId, isActive])
  @@index([programId])
  @@index([triggerEngine, isActive])
  @@map("reward_rules")
}

/// Family Communication — AI Conversation with mandatory parent approval
/// enforced at the schema level (Architecture 1.0 Decision 8).
model ChildMessage {
  familyId  String  @map("family_id") @db.Uuid
  id             String                 @id @default(uuid()) @db.Uuid
  childId        String                 @map("child_id") @db.Uuid
  fromUserId     String?                @map("from_user_id") @db.Uuid
  authorType     MessageAuthorType      @map("author_type")
  approvalStatus MessageApprovalStatus  @default(NOT_REQUIRED) @map("approval_status")
  category       String
  title          String
  body           String
  /// The notification payload — the SAME shape `notifications.data` carries on
  /// the parent surface, so one decision does not render two ways. Today it
  /// holds `deepLink`; see migration 0023 for why this is a JSON payload and
  /// not a single-purpose `deep_link` column.
  ///
  /// A CHILD-READABLE ROW: never a `familyId`, never a `childId`, never a token.
  /// A deep link is a destination, not a capability — the server re-authorizes
  /// on the next call whatever the link claims.
  data           Json?
  deliveredAt    DateTime?              @map("delivered_at")
  acknowledgedAt DateTime?              @map("acknowledged_at")
  createdAt      DateTime               @default(now()) @map("created_at")

  /// B9 — THE OTHER HALF OF THE NOTIFICATION SURFACE, and the reason the fix
  /// is not one column on one table.
  ///
  /// `SmartNotificationIntegrationService.deliver` routes PARENT candidates to
  /// `notifications` and CHILD candidates to THIS table (through
  /// `FamilyCommunicationService.draftAiMessage`, which is where the approval
  /// gate lives). A child-targeted notification is therefore a `child_messages`
  /// row, and it had exactly the same duplicate exposure — with no five-minute
  /// window in front of it at all.
  ///
  /// NULLABLE here, unlike `notifications.source_event_id`, and that is a
  /// stated distinction rather than an inconsistency: this table also holds
  /// PARENT-AUTHORED messages, which are not caused by any event and must not
  /// be deduplicated — a parent may legitimately send «أحسنت» twice. NULL means
  /// «a human wrote this», and PostgreSQL treats NULLs as distinct in a unique
  /// index, so the constraint below binds exactly the machine-generated rows.
  sourceEventId  String?                @map("source_event_id") @db.VarChar(200)

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  fromUser User? @relation(fields: [fromUserId], references: [id], onDelete: SetNull)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, sourceEventId])
  @@index([childId, deliveredAt])
  @@index([approvalStatus])
  @@index([familyId])
  @@map("child_messages")
}

model FamilyBroadcastMessage {
  id         String   @id @default(uuid()) @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  authoredByUserId String @map("authored_by_user_id") @db.Uuid
  title      String
