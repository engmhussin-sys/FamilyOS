// ============================================================================
// AI FAMILY DIGITAL COACH — DATABASE SCHEMA (Prisma)
// ============================================================================
// Scope: Phase 1 (MVP) as defined in docs/database/README.md
// Conventions:
//   - Every table uses a UUID primary key (id).
//   - Every table (except AuditLog, which is append-only/immutable) has
//     createdAt / updatedAt / deletedAt for soft-delete support.
//   - Table names are snake_case in Postgres, camelCase in Prisma Client.
//   - Foreign keys are always indexed explicitly (@@index) even though
//     Postgres/Prisma create some indexes implicitly, to keep intent explicit
//     for future maintainers.
//   - Sensitive fields (see docs/database/README.md §5 Security) are encrypted
//     at the application layer before being persisted (Prisma stores the
//     ciphertext as a String/Bytes column) — this schema documents that with
//     comments; encryption itself lives in the backend's Crypto module.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // PRISMA 7. `binaryTargets` and `previewFeatures = ["driverAdapters"]` are
  // both gone, and their absence is the upgrade's biggest win rather than a
  // deletion.
  //
  // Prisma 7 makes DRIVER ADAPTERS THE DEFAULT and removes the native QUERY
  // engine. The comment that used to live here described a real deploy-time
  // bug — a downloaded engine built for openssl-1.1.x refusing to load inside
  // node:20-alpine — and a second one described this repository's offline
  // WASM workaround, needed because `binaries.prisma.sh` answers 403 in our
  // build environments. AT RUNTIME both problems are now structurally absent:
  // no query-engine binary to download, no libssl to match. The client talks
  // to PostgreSQL through `pg`, which is plain JavaScript.
  //
  // WHAT IS NOT GONE — corrected here, because an earlier version of this
  // comment claimed it was: THE SCHEMA ENGINE IS STILL A NATIVE BINARY. The
  // CLI fetches it on demand for `migrate` and `db push`, and in this
  // repository's build environments that fetch still answers 403:
  //
  //   Failed to fetch sha256 checksum at https://binaries.prisma.sh/
  //     all_commits/<hash>/debian-openssl-3.0.x/schema-engine.gz.sha256
  //     — 403 Forbidden
  //
  // Reproduced 2026-08-22, with and without
  // PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 (which skips the checksum and
  // then fails on the engine itself). So the honest split is: the APPLICATION
  // needs no binary, MIGRATIONS still do. Where the fetch is blocked, apply
  // the committed `prisma/migrations/*/migration.sql` files with psql — the
  // same statements `migrate deploy` would run, which is how this repository's
  // integration suites get a schema.
}

datasource db {
  provider = "postgresql"
  // PRISMA 7 removed `url` from the schema. The connection is supplied by the
  // ADAPTER — at runtime by `PrismaService`, and for the CLI by
  // `prisma.config.ts`. One fewer place for a production URL to be written
  // down, which is the point of the change rather than a side effect of it.
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum FamilyRole {
  OWNER // billing owner, can delete the family, manage co-parents
  PARENT // full parenting permissions, no billing/deletion rights
}

enum SubscriptionPlan {
  FREE
  /// PHASE D. CONTEXT §6 names four consumer tiers — Free / Basic / Premium /
  /// Family — and this enum was missing the second one. ADDED, not renamed:
  /// `ALTER TYPE ... ADD VALUE` is safe on a table that has rows; a rename is
  /// not, and 2,476 passing tests depend on the four values below.
  BASIC
  PREMIUM
  FAMILY
  ENTERPRISE
}

/// Sprint 8 (Billing Platform) additions — kept separate from the
/// pre-existing SubscriptionPlan enum above (which stays as Family's
/// cached-current-tier field, same pattern as Device.trustLevel) rather
/// than renamed/merged, avoiding a breaking change to an already-used field.
/// PHASE D adds the three lifecycle states the brief names that this database
/// could not represent. It does NOT rename `TRIALING` -> `TRIAL` or
/// `CANCELED` -> `CANCELLED`: the brief's vocabulary is owned by
/// `src/modules/billing/domain/subscription-status.ts`, which holds the ONE
/// bidirectional mapping and is proven total by test. See the PHASE D section
/// at the bottom of this file.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  /// PHASE D. The state Fawry makes unavoidable: the customer has a payment
  /// reference and has not paid yet. NOT entitlement-bearing.
  PENDING
  /// PHASE D. Payment failed or the term lapsed, and the household keeps FULL
  /// access for a configured window (Q17: 7 days) with a non-punitive notice.
  GRACE_PERIOD
  /// PHASE D. A completed refund. Terminal, and distinct from CANCELED: money
  /// went back, so entitlement is revoked immediately rather than at period end.
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentProvider {
  STRIPE
  PAYMOB
  FAWRY
  MANUAL
  /// Sprint 9 addendum \u2014 extends the already-approved adapter pattern
  /// (Decision established Sprint 8). Structurally different from the
  /// four above: purchases are client-initiated (StoreKit/Play Billing),
  /// this backend verifies rather than charges \u2014 see AppleIAPAdapter's
  /// own docstring.
  APPLE_IAP
  GOOGLE_PLAY
  /// PHASE D. The Saudi card/mada-capable gateway. CONTEXT §2 names Moyasar
  /// or Tap; `00-Company-Response.md` Q16 leaves the final pick to two
  /// commercial offers. The ADAPTER is written against the interface either
  /// way — see `HUMAN DECISION REQUIRED #4` in the Phase D report.
  MOYASAR
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum DeviceOwnerType {
  PARENT
  CHILD
}

enum DeviceStatus {
  PENDING_PAIRING
  ACTIVE
  REVOKED
  LOST
}

// Granular, auditable consent — one row per (child, consentType).
// This is the technical backbone of the project's "privacy first" principle:
// no AI module may process a category of data without an active consent row.
enum ConsentType {
  DATA_COLLECTION
  LOCATION_TRACKING
  APP_USAGE_MONITORING
  AI_BEHAVIOR_ANALYSIS
  KEYBOARD_BEHAVIOR_ANALYSIS
  HEALTH_DATA
}

enum AppRuleType {
  BLOCK
  ALLOW
  TIME_LIMIT
}

enum ZoneType {
  HOME
  SCHOOL
  CUSTOM
}

enum LocationEventType {
  ENTER_ZONE
  EXIT_ZONE
  PERIODIC_PING
  SOS
}

enum AlertCategory {
  DIGITAL_SAFETY
  BEHAVIOR
  HEALTH
  EDUCATION
  LOCATION
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  NEW
  REVIEWED
  DISMISSED
  ESCALATED
}

enum ActorType {
  USER
  DEVICE
  SYSTEM
  // SPRINT F2. A member of THIS PLATFORM'S STAFF acting on a household from the
  // operator console. Until now every such action was recorded as SYSTEM, which
  // put a scheduled sweep and a support agent's suspension in the same bucket —
  // so «who did this» had no answer that a compliance review could accept.
  OPERATOR
}

// --- Secure Pairing (Step 2.2.1) — see docs/architecture/pairing-*.md ---

/// Per trust-levels-framework.md. Changes RARELY (Decision-043) — never
/// recomputed on a routine heartbeat. Cached on Device, derived from
/// pairing-time verification events, not incrementally mutated.
enum TrustLevel {
  L0_UNKNOWN
  L1_REGISTERED
  L2_VERIFIED
  L3_ATTESTED
  L4_ENTERPRISE
  L5_HIGH_TRUST // reserved — no current logic assigns this value
}

/// Per risk-score-framework.md v2. Changes frequently (Decision-043) —
/// this is a cached summary of the LATEST DeviceRiskAssessment row, not
/// a value mutated in place by many writers.
enum RiskLevel {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Per pairing-state-machine.md §4. Device.status (existing DeviceStatus
/// enum, 4 values) remains the fast-read summary field; this is the
/// richer state tracked per-event in DevicePairingEvent below.
enum PairingState {
  INVITATION_CREATED
  INVITATION_SENT
  INVITATION_OPENED
  AUTHENTICATING
  DEVICE_REGISTERED
  DEVICE_VERIFIED
  CAPABILITIES_UPLOADED
  PARENT_CONFIRMED
  POLICY_ASSIGNED
  ACTIVATED
  HEALTHY
  DEGRADED
  SUSPENDED
  REVOKED
  REMOVED
  /// Terminal, non-retryable — added during Step 2.2.2: the original
  /// state list had no distinct value for a pairing attempt that ends
  /// via explicit parent rejection or authentication failure
  /// (pairing-state-machine.md §6's "terminal failures"). Reusing
  /// REVOKED would have falsely implied the device was once trusted.
  REJECTED
  /// Terminal — an invitation's TTL lapsed with no action taken.
  EXPIRED
}

/// Per pairing-backend-domain-architecture.md §5, reconciled with
/// Decision-059's example list. Superset, not a replacement — every
/// transition in PairingState has a corresponding event here.
enum PairingEventType {
  PAIRING_INVITED
  PAIRING_ACCEPTED
  PAIRING_REJECTED
  PAIRING_EXPIRED
  AUTHENTICATION_STARTED
  AUTHENTICATION_SUCCEEDED
  AUTHENTICATION_FAILED
  DEVICE_REGISTERED
  DEVICE_VERIFIED
  DEVICE_VERIFICATION_FAILED
  CAPABILITIES_UPLOADED
  PARENT_CONFIRMED
  POLICY_ASSIGNED
  DEVICE_ACTIVATED
  ACTIVATION_BLOCKED_HIGH_RISK
  HEARTBEAT_RECEIVED
  HEARTBEAT_MISSED
  DEVICE_SUSPENDED
  DEVICE_REACTIVATED
  DEVICE_REVOKED
  DEVICE_REMOVED
  /// Sprint 2 — trust-level changes are annotated events, not
  /// pairing-state transitions (Trust is static per Decision-043).
  DEVICE_TRUST_CHANGED
}

// ============================================================================
// DOMAIN: IDENTITY & FAMILY
// ============================================================================

/// A parent/guardian account. Children do NOT have a User row in the MVP —
/// they authenticate via Device pairing + PIN (see Device, ChildSession).
/// This deliberately minimizes PII collected about the child at the account
/// level (COPPA/GDPR-friendly: no child email, no child password).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name")
  phone           String?
  /// PHASE F (`F6-009`, `PF-E-002`). ARABIC, because CONTEXT §1 is a locked
  /// decision and not a preference: first markets Egypt then Saudi Arabia,
  /// first language Arabic, real RTL and not a translation. This column is what
  /// `NotificationContextAssembler.readLocale` reads to choose the column of
  /// `COPY_CATALOGUE` every sentence a household receives is rendered from, so
  /// an English default meant English notifications for an Egyptian family that
  /// simply did not send a `locale` on registration. See migration 0019.
  locale          String     @default("ar")
  timezone        String     @default("UTC")
  status          UserStatus @default(PENDING_VERIFICATION)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  /// CLOSES A REAL GAP (proactive business/code audit): zero Terms of
  /// Service acceptance tracking existed anywhere. `termsVersion` is a
  /// plain string (not a foreign key to a "legal documents" table —
  /// that's a real future upgrade once more than one document/version
  /// needs tracking) so a future re-acceptance flow can compare
  /// against whatever version is currently in force. Both nullable:
  /// every user created before this migration honestly has no
  /// recorded acceptance — never backfilled with a fake timestamp.
  termsAcceptedAt DateTime?  @map("terms_accepted_at")
  termsVersion    String?    @map("terms_version")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  familyMemberships FamilyMember[]
  refreshTokens     RefreshToken[]
  ownedDevices      Device[]          @relation("UserOwnedDevices")
  consentsGranted   ParentalConsent[] @relation("ConsentGrantedBy")
  organizationMemberships OrganizationMember[] @relation("OrganizationMemberships")
  notifications     Notification[]
  auditLogEntries   AuditLog[]        @relation("AuditActorUser")
  createdHabits     Habit[]
  createdRewardCatalogItems RewardCatalogItem[]
  authoredChildMessages ChildMessage[]
  authoredBroadcasts FamilyBroadcastMessage[]
  supportRequests    SupportRequest[]
  createdRewardPrograms RewardProgram[]

  @@index([status])
  @@map("users")
}

/// A household. All children, devices, and policies are scoped to a Family.
/// Every authorization check in the backend is "does this user belong to
/// the family that owns this resource?" — see docs/database/README.md §5.
model Family {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  timezone         String            @default("UTC")
  /// ISO-3166-1 alpha-2, a REAL foreign key to `countries` (migration 0022) —
  /// so an unsupported market cannot be stored by ANY code path, present or
  /// future, rather than depending on whichever validator happens to run.
  /// `countries` is the launch-market catalogue and adding a market is an
  /// INSERT, not a migration.
  ///
  /// NULLABLE because families created before this column exist and there is no
  /// true value to backfill them with — defaulting them to 'EG' would make the
  /// growth dashboard report invented market data as measured fact, which is the
  /// one thing that dashboard's NOT MEASURED discipline exists to prevent.
  countryCode      String?           @map("country_code") @db.VarChar(2)
  subscriptionPlan SubscriptionPlan  @default(FREE) @map("subscription_plan")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  members  FamilyMember[]
  children Child[]
  devices  Device[]
  subscription Subscription?
  rewardCatalogItems RewardCatalogItem[]
  rewardRules        RewardRule[]
  broadcastMessages  FamilyBroadcastMessage[]
  challenges         FamilyChallenge[]
  supportRequests    SupportRequest[]

  country  Country? @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  /// NOTE: `families_country_code_idx` is a PARTIAL index
  /// (`WHERE country_code IS NOT NULL`) created by migration 0022. Prisma has no
  /// syntax for a partial index, so it is deliberately ABSENT from this block
  /// rather than declared as a full index that would not match the database.

  parentalConsents ParentalConsent[]
  devicePairingEvents DevicePairingEvent[]
  screenTimePolicies ScreenTimePolicy[]
  dailyBehavioralSnapshots DailyBehavioralSnapshot[]
  appUsageLogs AppUsageLog[]
  appBlockRules AppBlockRule[]
  locationSafeZones LocationSafeZone[]
  locationEvents LocationEvent[]
  aiRiskScores AiRiskScore[]
  aiAlerts AiAlert[]
  aiAlertNotes AiAlertNote[]
  aiMemoryEntries AiMemoryEntry[]
  notifications Notification[]
  notificationDeliveries NotificationDelivery[]
  notificationDecisions NotificationDecision[]
  notificationPolicySettings NotificationPolicySetting[]
  habits Habit[]
  habitCompletions HabitCompletion[]
  rewardsAccounts RewardsAccount[]
  rewardsLedgerEntries RewardsLedgerEntry[]
  childBadgeAwards ChildBadgeAward[]
  rewardRedemptions RewardRedemption[]
  childMessages ChildMessage[]
  lifeTimelineEvents LifeTimelineEvent[]
  childDigitalTwinProjections ChildDigitalTwinProjection[]
  nutritionLogs NutritionLog[]
  hydrationLogs HydrationLog[]
  sleepLogs SleepLog[]
  activityLogs ActivityLog[]
  physicalMeasurementLogs PhysicalMeasurementLog[]
  healthScoreDailies HealthScoreDaily[]
  faithPractices FaithPractice[]
  faithPracticeLogs FaithPracticeLog[]
  learningGoals LearningGoal[]
  learningSessions LearningSession[]
  learningAssessments LearningAssessment[]
  smartTasks SmartTask[]
  familyChallengeParticipations FamilyChallengeParticipation[]
  deviceRiskAssessments DeviceRiskAssessment[]
  appCatalogEntries AppCatalogEntry[]
  invoices Invoice[]
  auditLogs AuditLog[]
  aiUsageLogs AiUsageLog[]
  domainEvents DomainEvent[]
  outboxMessages OutboxMessage[]
  consumedMessages ConsumedMessage[]

  // -- F4 (Smart Learning & Reward Engine) --
  rewardPrograms RewardProgram[]
  achievementRequests AchievementRequest[]
  verificationAttempts VerificationAttempt[]
  screenTimeRewardGrants ScreenTimeRewardGrant[]
  rewardFulfilments RewardFulfilment[]

  // -- B5 (server-owned quiz bank + evidence upload) --
  quizQuestions QuizQuestion[]
  quizAssignments QuizAssignment[]
  achievementEvidence AchievementEvidence[]

  // -- PHASE C P4 (scheduler): one row per family-scoped job execution. --
  jobRuns JobRun[]

  // -- PHASE D (commercial subscription & payments) --
  trial                Trial?
  providerAccountLinks ProviderAccountLink[]
  paymentTransactions  PaymentTransaction[]
  refunds              Refund[]
  entitlements         Entitlement[]
  paymentWebhookEvents PaymentWebhookEvent[]

  // -- PHASE D (growth, attribution, referral) --
  acquisitionAttribution   AcquisitionAttribution?
  activation               FamilyActivation?
  referralCode             ReferralCode?
  referralLinks            ReferralLink[]
  referralEventsAsReferrer ReferralEvent[]         @relation("ReferrerFamily")
  referralRewards          ReferralReward[]
  growthAlerts             GrowthAlert[]

  @@map("families")
}

/// Join table: which Users belong to which Family, and with what role.
/// Supports co-parenting (two parents, one family) from day one.
///
/// PHASE C (A4 SA-005): `role` is no longer a label. It is read by
/// `assertRoleAllowed()` on every authenticated request (via the signed
/// `familyRole` JWT claim) and re-read from THIS TABLE, inside the mutating
/// transaction, by every destructive operation. Migration 0009 adds a PARTIAL
/// UNIQUE INDEX -- one live OWNER per family -- which Prisma's schema language
/// cannot express (no `WHERE` on `@@unique`), so it lives in SQL only. Read
/// 0009_rbac_family_ownership/migration.sql before changing anything here.
model FamilyMember {
  id        String     @id @default(uuid()) @db.Uuid
  familyId  String     @map("family_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      FamilyRole @default(PARENT)
  joinedAt  DateTime   @default(now()) @map("joined_at")
  deletedAt DateTime?  @map("deleted_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("family_members")
}

/// A child profile. dateOfBirth is required — it drives age-appropriate
/// AI behavior and COPPA/GDPR-age-of-consent logic at the application layer.
model Child {
  id          String    @id @default(uuid()) @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  firstName   String    @map("first_name")
  lastName    String?   @map("last_name")
  dateOfBirth DateTime  @map("date_of_birth") @db.Date
  gender      String?
  avatarUrl   String?   @map("avatar_url")
  pinCodeHash String?   @map("pin_code_hash") // child-app login PIN, hashed
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  family              Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  devices             Device[]
  consents            ParentalConsent[]
  screenTimePolicies  ScreenTimePolicy[]
  appBlockRules       AppBlockRule[]
  appUsageLogs        AppUsageLog[]
  dailyBehavioralSnapshots DailyBehavioralSnapshot[]
  safeZones           LocationSafeZone[]
  locationEvents      LocationEvent[]
  aiRiskScores        AiRiskScore[]
  aiAlerts            AiAlert[]
  notifications       Notification[]
  notificationDeliveries NotificationDelivery[]
  notificationDecisions NotificationDecision[]
  aiMemoryEntries     AiMemoryEntry[]
  habits              Habit[]
  habitCompletions    HabitCompletion[]
  rewardsAccount      RewardsAccount?
  rewardsLedgerEntries RewardsLedgerEntry[]
  badgeAwards         ChildBadgeAward[]
  rewardRedemptions   RewardRedemption[]
  messages            ChildMessage[]
  timelineEvents      LifeTimelineEvent[]
  digitalTwinProjection ChildDigitalTwinProjection?
  nutritionLogs       NutritionLog[]
  hydrationLogs       HydrationLog[]
  sleepLogs           SleepLog[]
  activityLogs        ActivityLog[]
  physicalMeasurementLogs PhysicalMeasurementLog[]
  healthScoreDaily    HealthScoreDaily[]
  faithPractices      FaithPractice[]
  faithPracticeLogs   FaithPracticeLog[]
  learningGoals       LearningGoal[]
  learningSessions    LearningSession[]
  learningAssessments LearningAssessment[]
  smartTasks          SmartTask[]
  challengeParticipations FamilyChallengeParticipation[]

  // -- F4 (Smart Learning & Reward Engine) --
  rewardPrograms      RewardProgram[]
  achievementRequests AchievementRequest[]
  verificationAttempts VerificationAttempt[]
  screenTimeRewardGrants ScreenTimeRewardGrant[]
  rewardFulfilments   RewardFulfilment[]

  // -- B5 (server-owned quiz bank + evidence upload) --
  quizAssignments     QuizAssignment[]
  achievementEvidence AchievementEvidence[]

  @@index([familyId])
  @@map("children")
}

/// Explicit, auditable, revocable consent per data-collection category.
/// No AI/monitoring module is permitted to run for a child unless a matching
/// row exists here with granted = true and revokedAt = null.
model ParentalConsent {
  familyId  String  @map("family_id") @db.Uuid
  id              String      @id @default(uuid()) @db.Uuid
  childId         String      @map("child_id") @db.Uuid
  consentType     ConsentType @map("consent_type")
  granted         Boolean     @default(true)
  grantedByUserId String      @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime    @default(now()) @map("granted_at")
  revokedAt       DateTime?   @map("revoked_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  child         Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  grantedByUser User  @relation("ConsentGrantedBy", fields: [grantedByUserId], references: [id])

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([childId, consentType])
  @@index([childId])
  @@index([familyId])
  @@map("parental_consents")
}

// ============================================================================
// DOMAIN: DEVICES & AUTH
// ============================================================================

/// A physical device running either the Parent App or the Child App.
/// Exactly one of (userId, childId) is set, matching ownerType.
model Device {
  id                 String          @id @default(uuid()) @db.Uuid
  familyId           String          @map("family_id") @db.Uuid
  ownerType          DeviceOwnerType @map("owner_type")
  userId             String?         @map("user_id") @db.Uuid
  childId            String?         @map("child_id") @db.Uuid
  platform           DevicePlatform
  deviceModel        String?         @map("device_model")
  osVersion          String?         @map("os_version")
  appVersion         String?         @map("app_version")
  pushToken          String?         @map("push_token")
  pairingCodeHash    String?         @map("pairing_code_hash") // one-time pairing secret, hashed
  status             DeviceStatus    @default(PENDING_PAIRING)
  lastSeenAt         DateTime?       @map("last_seen_at")
  pairedAt           DateTime?       @map("paired_at")

  // --- Secure Pairing additions (Step 2.2.1) ---
  // All five nullable/defaulted — additive-only per
  // schema-change-proposal-pairing.md, zero impact on existing rows.
  /// Device's Keystore-generated public key (CR-1). Null until Device
  /// Registration (pairing-backend-domain-architecture.md's
  /// /pairing/device/register) completes.
  publicKey              String?    @map("public_key")
  /// Key Attestation certificate chain (CR-1), where the device's
  /// hardware supports it — null is an expected, non-error outcome for
  /// a meaningful fraction of real devices (trust-levels-framework.md §3).
  attestationChain       String?    @map("attestation_chain")
  /// Cached, derived summary — changes rarely (Decision-043). The full
  /// derivation history lives in DevicePairingEvent below, not here.
  trustLevel             TrustLevel @default(L0_UNKNOWN) @map("trust_level")
  /// CR-4. Which version of the pairing state machine this device
  /// paired under (pairing-state-machine.md, Decision-037's versioning).
  pairingProtocolVersion String?    @map("pairing_protocol_version")
  /// CR-5. Hash of (ANDROID_ID + publicKey + basic hardware profile) —
  /// deliberately NOT IMEI/serial/MAC, per the Privacy Rule in
  /// docs/database/README.md §6.4. Used for replacement-detection only,
  /// not cross-app tracking.
  deviceFingerprint      String?    @map("device_fingerprint")

  /// Sprint 4 — Full Capability Engine's cached report (Decision-019:
  /// current-state cache, not history — same pattern as trustLevel
  /// above, not a new append-only table).
  capabilityProfile      Json?      @map("capability_profile")
  capabilityProfileHash  String?    @map("capability_profile_hash")
  /// Sprint 4 — latest heartbeat telemetry (battery/storage/connectivity),
  /// cached current-state like capabilityProfile above — history isn't
  /// needed for this MVP (a full DeviceHealthScore history table is a
  /// deferred follow-up, not built here to avoid speculative schema).
  lastTelemetry          Json?      @map("last_telemetry")

  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  deletedAt          DateTime?       @map("deleted_at")

  family           Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user             User?                 @relation("UserOwnedDevices", fields: [userId], references: [id], onDelete: Cascade)
  child            Child?                @relation(fields: [childId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  appCatalog       AppCatalogEntry[]
  appUsageLogs     AppUsageLog[]
  dailyBehavioralSnapshots DailyBehavioralSnapshot[]
  locationEvents   LocationEvent[]
  pairingEvents    DevicePairingEvent[]
  riskAssessments  DeviceRiskAssessment[]

  /// `last_seen_at` IS INDEXED, AND THE INDEX IS NOT DECLARED HERE.
  ///
  /// Migration 0025 adds `devices_last_seen_at_active_idx` — a PARTIAL index
  /// `("last_seen_at") WHERE "deleted_at" IS NULL` — which Prisma's schema
  /// language cannot express (no `WHERE` on `@@index`), exactly like migration
  /// 0009's one-live-OWNER unique index on `family_members` and migration
  /// 0022's `families_country_code_idx`. It lives in SQL only.
  ///
  /// It is the access path for EVERY "active" number this product prints —
  /// active devices, active families, ACTIVE_PARENTS, ACTIVE_CHILDREN, DAU /
  /// WAU / MAU and every retention cohort all filter this column together with
  /// `deleted_at IS NULL`. Read 0025's header before adding a second index on
  /// `last_seen_at`: that column is written by every heartbeat from every
  /// paired device, and the header records which composite was measured and
  /// why it was deliberately not shipped.
  @@index([familyId])
  @@index([userId])
  @@index([childId])
  @@map("devices")
}

/// Append-only pairing/trust audit ledger (CR-2, Decision-039's
/// "Security/Trust/Pairing/Audit" category rule — no UPDATE or DELETE
/// against a historical row, ever). This is the "PairingAuditEvents"
/// entity from Step 2.2.1's brief, and the sole source of truth
/// pairing-recovery.md's "resume from last confirmed state" logic and
/// pairing-backend-domain-architecture.md §1.5's derived PairingSession
/// read both depend on.
model DevicePairingEvent {
  familyId  String  @map("family_id") @db.Uuid
  id         String           @id @default(uuid()) @db.Uuid
  /// Nullable — secondary reference, populated from DEVICE_REGISTERED
  /// onward. Per Decision-065/066: the pairing lifecycle is a
  /// Parent→Family→Child→Device relationship chain, not a device
  /// lifecycle — the device only enters partway through, so it cannot be
  /// the primary key of this table.
  deviceId   String?          @map("device_id") @db.Uuid
  /// Required — the Primary Owner of every pairing event (Decision-066).
  /// Set from the very first event (PAIRING_INVITED) and never null,
  /// including after a device is registered. Child Timeline queries
  /// (docs/architecture/pairing-step-2-2-2-state-machine-service.md)
  /// always key on this, not deviceId — this is what keeps a child's
  /// pairing history coherent across a future device replacement.
  childId    String           @map("child_id") @db.Uuid
  eventType  PairingEventType @map("event_type")
  fromState  PairingState?    @map("from_state") // null for the very first event (no prior state)
  toState    PairingState     @map("to_state")
  actorType  ActorType        @map("actor_type")
  actorId    String?          @map("actor_id") // userId or deviceId, matching actorType; null for SYSTEM
  metadata   Json?
  occurredAt DateTime         @default(now()) @map("occurred_at")

  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([deviceId, occurredAt])
  @@index([childId, occurredAt])
  @@index([familyId])
  @@map("device_pairing_events")
}

/// Append-only risk assessment history (CR-3, risk-score-framework.md
/// v2 §7). One row per assessment — never overwritten. Device.trustLevel
/// (above) is a SEPARATE, rarely-changing cache; this table is the
/// frequently-changing counterpart (Decision-043's core distinction).
model DeviceRiskAssessment {
  familyId  String  @map("family_id") @db.Uuid
  id             String    @id @default(uuid()) @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  overallRisk    Int       @map("overall_risk") // 0-100
  overallLevel   RiskLevel @map("overall_level")
  /// One entry per category from risk-score-framework.md §3
  /// (security/privacy/compliance/stability/connectivity/behavioral).
  categoryScores Json      @map("category_scores")
  /// Human-readable explainability strings (Decision-047) — never
  /// omitted, per that document's binding rule.
  reasons        Json
  assessedAt     DateTime  @default(now()) @map("assessed_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([deviceId, assessedAt])
  @@index([familyId])
  @@map("device_risk_assessments")
}

/// Refresh tokens are bound to a device, never issued "floating" —
/// this lets us revoke a single device's session without logging out
/// every device the user owns. Token value itself is never stored raw.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  /// SA-002 (Refresh Token Reuse Detection, RFC 6819 §5.2.2.3 / OAuth 2.0
  /// Security BCP §4.13.2). Every rotation chain shares one lineage id:
  /// the very first token of a session sets it to its own id, and each
  /// rotated successor inherits it. Presenting an already-rotated token
  /// therefore identifies the whole compromised chain in a single
  /// indexed query, and the entire family is revoked at once.
  familyTokenId String  @map("family_token_id") @db.Uuid
  /// Set on the token that was consumed, pointing at the token issued in
  /// its place. Makes the rotation chain reconstructable for forensics.
  replacedById  String? @map("replaced_by_id") @db.Uuid

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([familyTokenId])
  @@map("refresh_tokens")
}

