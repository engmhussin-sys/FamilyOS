  // DP-1 gap found by the F2 registry test: this table carried family_id from
  // the start but never had an index on it, so every family's broadcast list
  // was a sequential scan of every family's broadcasts.
  @@index([familyId, createdAt])
  @@map("family_broadcast_messages")
}

/// Unified Life Timeline — append-only, single table for every engine
/// (Architecture 1.0 Decision 10). No engine writes into another
/// engine's table; every engine writes here through the same one service.
model LifeTimelineEvent {
  familyId  String  @map("family_id") @db.Uuid
  id           String            @id @default(uuid()) @db.Uuid
  childId      String            @map("child_id") @db.Uuid
  sourceEngine String            @map("source_engine")
  category     TimelineCategory
  eventType    String            @map("event_type")
  title        String
  occurredAt   DateTime          @default(now()) @map("occurred_at")
  /// PHASE C (`PC-B-006`) — CARRIES AN IDEMPOTENCY KEY, AND AN INDEX THIS FILE
  /// CANNOT DECLARE. Recorded here so it is not invisible to the next reader.
  ///
  /// Migration 0010 adds:
  ///   CREATE UNIQUE INDEX life_timeline_events_reward_source_key_uq
  ///       ON life_timeline_events (child_id, ((metadata ->> 'sourceKey')))
  ///    WHERE (metadata ->> 'sourceKey') IS NOT NULL;
  ///
  /// It is the FOURTH link of ONE BUSINESS EVENT -> ONE REWARD -> ONE TIMELINE
  /// ENTRY -> ONE NOTIFICATION. The other three are `@@unique` on their own
  /// models; this one is not, because Prisma cannot express a PARTIAL index over
  /// a JSON EXPRESSION — and the key lives inside `metadata` rather than in a
  /// column of its own only because `prisma generate` is unreachable in this
  /// environment (binaries.prisma.sh answers 403 for both engines), so a new
  /// column could not reach the generated client. Migration 0010's header
  /// carries the full reasoning.
  ///
  /// PARTIAL, so it is additive: only the `reward_granted` entry sets a
  /// `sourceKey`; every other engine's timeline write is unaffected.
  ///
  /// THE FOLLOW-UP, stated so it is not forgotten: once the Prisma engines are
  /// downloadable, promote it to a real `sourceKey String? @map("source_key")`
  /// field with `@@unique([childId, sourceKey])`, backfilling nothing.
  metadata     Json?

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([childId, occurredAt])
  @@index([childId, category])
  @@index([familyId])
  @@map("life_timeline_events")
}

/// Digital Twin — an aggregated READ PROJECTION, not a source of truth.
/// Rebuildable from source tables at any time; if it and the source
/// tables ever disagree, the source tables win (Architecture 1.0 §6.1).
model ChildDigitalTwinProjection {
