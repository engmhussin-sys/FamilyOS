/// Location pings. latitude/longitude are stored ENCRYPTED at the
/// application layer (see docs/database/README.md §5) — the columns here
/// hold ciphertext, typed String rather than Float, on purpose.
/// expiresAt drives a scheduled purge job (default retention: 30 days)
/// so raw location history does not accumulate indefinitely.
model LocationEvent {
  familyId  String  @map("family_id") @db.Uuid
