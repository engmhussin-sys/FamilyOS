  priority    String   @default("NORMAL") // LOW | NORMAL | HIGH — a plain string, same reasoning as category
  /// Whether a parent authored this (custom) or it's a built-in
  /// default — mirrors AiMemoryEntry.category's "plain string, grows
  /// without migration" reasoning: category is a string, not an enum.
  isCustom    Boolean  @default(true) @map("is_custom")
  isShared    Boolean  @default(false) @map("is_shared") // family/shared task — Social Score input
  createdByUserId String? @map("created_by_user_id") @db.Uuid
