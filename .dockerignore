# Build context for `docker build -f apps/backend/Dockerfile .` — the context
# is the repository ROOT (see that file's header), so this list is what keeps
# the upload small and the layers stable.
#
# Deliberately a DENY list, not an allow list: `**` + re-inclusions is clever,
# unreadable, and impossible to verify without a Docker daemon — which this
# repository's authoring environment does not have.

# Dependencies and build output — reinstalled/rebuilt inside the image. A host
# node_modules leaking into the context is how a sandbox-specific binary (or a
# broken Prisma shim) reaches a production image.
**/node_modules
**/dist
**/build
apps/backend/tsconfig.build.tsbuildinfo

# The two Flutter apps: nothing in this image builds Dart.
apps/parent-app
apps/child-app
**/.dart_tool
**/.flutter-plugins
**/.flutter-plugins-dependencies

# The admin dashboard is a separate deployment (a static bundle), not part of
# the backend image.
apps/admin-dashboard

# Secrets and local state — never in a build context, never in a layer.
**/.env
**/.env.*
**/*.pem
**/*.jks
**/*.keystore
**/google-services.json

# Local runtime artefacts
**/dump.rdb
apps/backend/.evidence-store
**/coverage
**/.nyc_output
**/*.log
build-logs

# VCS, editors, CI-only material
.git
.github
.vscode
.idea
**/.DS_Store
scripts/__pycache__

# Test material: the production image runs no tests. (`tsconfig.build.json`
# already excludes `test`; this keeps it out of the context as well.)
apps/backend/test
apps/backend/scripts
