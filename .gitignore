# Dependencies
node_modules/
# Compiled test artifacts (ts-jest/tsc occasionally emit these
# alongside .spec.ts source files — never real source, never committed)
apps/backend/test/**/*.js
apps/backend/test/**/*.js.map
apps/backend/prisma/seed.js
apps/backend/prisma/seed.js.map
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
# Stage logs written by scripts/mobile-build.sh|.ps1 (one directory per
# invocation). Diagnostics, never source — and never worth committing.
build-logs/

# Environment files — NEVER commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Prisma
apps/backend/prisma/migrations/**/migration.sql.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Testing / coverage
coverage/
.nyc_output/

# TypeScript build cache
*.tsbuildinfo

# Flutter / Dart
apps/*/.dart_tool/
apps/*/.flutter-plugins
apps/*/.flutter-plugins-dependencies
apps/*/.packages
apps/*/build/
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/ios/Pods/
apps/*/ios/.symlinks/
apps/*/ios/Flutter/Flutter.framework
apps/*/ios/Flutter/Flutter.podspec

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Misc
*.pem
.turbo/

# B5 (PA-B-019) — the LOCAL-DISK evidence storage root. Uploaded recitations
# and artifacts are child data; they belong on a disk or in a bucket, never in
# a git history. `EVIDENCE_STORAGE_ROOT` overrides the location; this is the
# default `LocalDiskEvidenceStorage` uses, and the e2e suite really writes here.
apps/backend/.evidence-store/

# Phase C — the Flutter static-preflight scripts are plain Python; their
# bytecode cache is a build artifact of running them, not source.
scripts/__pycache__/

# Redis snapshot artefact - never a source file
dump.rdb
**/dump.rdb

# Credentials for throwaway test households, written by
# scripts/seed-test-accounts.{sh,ps1}. The accounts are disposable; the habit
# of not committing a password is not. The script says so in its own output,
# and this line is what makes saying so true.
TEST-ACCOUNTS.txt
